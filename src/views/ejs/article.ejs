<!DOCTYPE html>
<html>

<head>
    <title>
        <%= article.title %>
    </title>
    <link rel="icon" href="/favicon.ico">
</head>

<body>
    <h1>
        <%= article.title %>
    </h1>
    <div>
        <%= article.content %>
    </div>
    <form action="/articles/remove/<%= article._id %>" method="POST"
        onsubmit="return confirm('Вы уверены, что хотите удалить эту статью?');">
        <input type="hidden" name="_method" value="DELETE">
        <!-- остальное без изменений -->
        <button type="submit"
            style="background-color: #ff4444; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; margin-top: 20px;">
            Удалить статью
        </button>
        <a href="/articles/list" class="btn btn-secondary">Отмена</a>
    </form>
</body>

</html>