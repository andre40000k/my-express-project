<!DOCTYPE html>
<html>

<head>
    <title>List of articles</title>
    <link rel="icon" href="/favicon.ico">
</head>

<body>
    <h1>All articles</h1>
    <a href="/articles/add" class="btn btn-secondary">Написать статтью</a>
    <ul>
        <% articles.forEach(article=> { %>
            <li>
                <a href="/articles/list/<%= article._id %>">
                    <%= article.title %>
                </a>
            </li>
            <% }) %>
    </ul>
    <a href="/articles/add" class="btn btn-secondary">Написать статтью</a>
</body>

</html>