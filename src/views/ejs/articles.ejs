<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <title>All articles</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .article-list {
            list-style: none;
            padding-left: 0;
        }

        .article-link {
            font-size: 1.1rem;
            padding: 8px 0;
            display: block;
        }

        .pagination {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }
    </style>
</head>

<body class="container mt-4">
    <h1 class="mb-4">Все статьи</h1>

    <a href="/" class="btn btn-primary mb-3">Main</a>
    <a href="/articles/add" class="btn btn-primary mb-3">New article</a>
    <a href="/articles/statistic" class="btn btn-primary mb-3">Statistic</a>

    <% if (articles.length===0) { %>
        <div class="alert alert-info">Статьи не найдены</div>
        <% } else { %>
            <ul class="article-list">
                <% articles.forEach(article=> { %>
                    <li>
                        <a href="/articles/list/<%= article._id %>" class="article-link text-decoration-none">
                            <%= article.title %>
                                <small class="text-muted">(<%= new Date(article.createdAt).toLocaleDateString() %>
                                        )</small>
                        </a>
                    </li>
                    <% }) %>
            </ul>

            <div class="pagination">
                <% if (currentPage> 1) { %>
                    <a href="/articles/list?page=<%= currentPage-1 %>" class="btn btn-outline-primary me-2">
                        ← Назад
                    </a>
                    <% } %>

                        <% for (let i=1; i <=totalPages; i++) { %>
                            <% if (i===currentPage) { %>
                                <span class="btn btn-primary mx-1">
                                    <%= i %>
                                </span>
                                <% } else { %>
                                    <a href="/articles/list?page=<%= i %>" class="btn btn-outline-primary mx-1">
                                        <%= i %>
                                    </a>
                                    <% } %>
                                        <% } %>

                                            <% if (currentPage < totalPages) { %>
                                                <a href="/articles/list?page=<%= currentPage+1 %>"
                                                    class="btn btn-outline-primary ms-2">
                                                    Вперед →
                                                </a>
                                                <% } %>
            </div>
            <% } %>
</body>

</html>