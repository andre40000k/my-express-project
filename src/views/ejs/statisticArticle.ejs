<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <title>Статистика статей</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .stat-card {
            margin-bottom: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>

<body class="container mt-4">
    <h1 class="mb-4">Статистика статей</h1>

    <a href="/articles/list" class="btn btn-primary mb-4">Back</a>

    <div class="row">
        <!-- Самая новая статья -->
        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Самая новая статья</h5>
                </div>
                <div class="card-body">
                    <% if (newestArticle) { %>
                        <h4>
                            <%= newestArticle.title %>
                        </h4>
                        <p class="text-muted">
                            Дата: <%= new Date(newestArticle.createdAt).toLocaleDateString() %>
                        </p>
                        <a href="/articles/list/<%= newestArticle._id %>" class="btn btn-sm btn-primary">
                            Перейти
                        </a>
                        <% } else { %>
                            <p class="text-muted">Нет данных</p>
                            <% } %>
                </div>
            </div>
        </div>

        <!-- Самая старая статья -->
        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Самая старая статья</h5>
                </div>
                <div class="card-body">
                    <% if (oldestArticle) { %>
                        <h4>
                            <%= oldestArticle.title %>
                        </h4>
                        <p class="text-muted">
                            Дата: <%= new Date(oldestArticle.createdAt).toLocaleDateString() %>
                        </p>
                        <a href="/articles/list/<%= oldestArticle._id %>" class="btn btn-sm btn-secondary">
                            Перейти
                        </a>
                        <% } else { %>
                            <p class="text-muted">Нет данных</p>
                            <% } %>
                </div>
            </div>
        </div>

        <!-- Самая длинная статья -->
        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Самая длинная статья</h5>
                </div>
                <div class="card-body">
                    <% if (longestArticle) { %>
                        <h4>
                            <%= longestArticle.title %>
                        </h4>
                        <p class="text-muted">
                            Символов: <%= longestArticle.contentLength || longestArticle.content.length %>
                        </p>
                        <a href="/articles/list/<%= longestArticle._id %>" class="btn btn-sm btn-info">
                            Перейти
                        </a>
                        <% } else { %>
                            <p class="text-muted">Нет данных</p>
                            <% } %>
                </div>
            </div>
        </div>
    </div>
</body>

</html>